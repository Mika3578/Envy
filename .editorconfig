# .editorconfig - Consistent coding styles across editors
# https://editorconfig.org

root = true

# Default settings for all files
[*]
indent_style = tab
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# C/C++ source files
[*.{c,cpp,h,hpp,inl,rc}]
indent_style = tab
indent_size = 4

# Visual Studio project files
[*.{vcxproj,vcxproj.filters,sln,props,targets}]
indent_style = tab
indent_size = 2
charset = utf-8-bom

# XML files
[*.{xml,xsd,xsl,config}]
indent_style = tab
indent_size = 2

# JSON files
[*.json]
indent_style = space
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false
indent_style = space
indent_size = 2

# Batch files
[*.{bat,cmd}]
end_of_line = crlf

# Shell scripts
[*.sh]
end_of_line = lf
indent_style = space
indent_size = 4

# Resource files
[*.rc]
charset = utf-16le

# INI/INF files
[*.{ini,inf}]
indent_style = space
indent_size = 4

# Makefiles
[Makefile]
indent_style = tab
