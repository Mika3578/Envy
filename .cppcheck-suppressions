# CppCheck suppressions for Envy project
# Temporary suppressions for legacy code patterns that will be addressed during modernization

# Windows API specific
windowsInclude:*
windowsFile:*
windowsGlobal:*

# MFC specific patterns
missingIncludeSystem:*.h
unusedFunction:*

# MFC/OLE declaration macros are unavailable to cppcheck's preprocessor
# without the MFC headers; configure-id noise, not findings. Keep this list
# narrow: a genuinely unknown macro outside MFC/OLE usage must stay visible
# so a file cppcheck could not parse is never reported as clean.
unknownMacro:DECLARE_MESSAGE_MAP
unknownMacro:BEGIN_MESSAGE_MAP
unknownMacro:END_MESSAGE_MAP
unknownMacro:DECLARE_DYNAMIC
unknownMacro:IMPLEMENT_DYNAMIC
unknownMacro:DECLARE_DYNCREATE
unknownMacro:IMPLEMENT_DYNCREATE
unknownMacro:DECLARE_INTERFACE_MAP
unknownMacro:BEGIN_INTERFACE_PART
unknownMacro:END_INTERFACE_PART
unknownMacro:ON_EVENT
unknownMacro:ON_MESSAGE
unknownMacro:ON_REGISTERED_MESSAGE
unknownMacro:ON_COMMAND
unknownMacro:ON_UPDATE_COMMAND_UI
unknownMacro:DEBUG_NEW
unknownMacro:afx_msg

# Legacy code patterns to be modernized
unusedPrivateFunction:*
unusedStructMember:*
variableScope:*

# Intentional null pointer usage (legacy code)
nullPointer:*

# Intentional memory handling (will migrate to smart pointers)
memleak:*
resourceLeak:*

# Win32 API conventions
windowsStyle:*
style:unusedFunction
