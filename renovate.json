{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":preserveSemverRanges"
  ],
  "labels": ["dependencies", "renovate"],
  "timezone": "Europe/Paris",
  "schedule": ["before 8am on Monday"],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "branchConcurrentLimit": 5,
  "rangeStrategy": "bump",
  "rebaseWhen": "conflicted",
  "enabledManagers": ["github-actions", "regex"],
  "ignorePaths": [
    "**/Plugins/PluginWizard/**",
    "**/Services/**"
  ],
  "packageRules": [
    {
      "description": "Group GitHub Actions minor/patch updates into one PR",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "GitHub Actions (non-major)",
      "automerge": false
    },
    {
      "description": "Keep major Actions bumps reviewable and ungrouped",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "renovate", "major"],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "Prefer commit SHA digests for third-party Actions supply-chain hygiene",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["dependencies", "security"]
  }
}
