{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(clang-format --dry-run *)",
      "Bash(clang-format-18 --dry-run *)",
      "Bash(python3 .github/scripts/check-agent-attribution.py *)",
      "Bash(bash .github/scripts/check-source-encoding.sh *)"
    ]
  }
}
