# Binary assets must not pass through text encoding / CRLF conversion.
# About.htm.gz / Browser.htm.gz were once committed as UTF-8-mangled data
# (U+FFFD replacement bytes), which broke gzip and dirtied every build.
*.gz binary

# Shell scripts must stay LF for Ubuntu CI runners
.github/scripts/*.sh text eol=lf

# First-party C/C++ line endings are predominantly CRLF in the working tree on
# Windows. We do not set a global eol= rule for *.cpp/*.h here: index/working-
# tree EOL is mixed today and a blanket rule would invite mass renormalization
# (see docs/10_dev/development-environment.md). Use .editorconfig end_of_line
# and avoid `git add --renormalize` unless #350 explicitly covers EOL.

