# Git Attributes for Envy Repository
# https://git-scm.com/docs/gitattributes

# =============================================================================
# Auto detect text files and perform LF normalization
# =============================================================================
* text=auto

# =============================================================================
# Source code - ensure consistent line endings
# =============================================================================
*.c         text diff=cpp
*.cpp       text diff=cpp
*.h         text diff=cpp
*.hpp       text diff=cpp
*.inl       text diff=cpp
*.idl       text

# =============================================================================
# Visual Studio files
# =============================================================================
*.sln       text eol=crlf
*.vcxproj   text eol=crlf
*.vcxproj.filters text eol=crlf
*.props     text eol=crlf
*.targets   text eol=crlf
*.ruleset   text eol=crlf
*.vsixmanifest text eol=crlf
*.vsct      text eol=crlf

# =============================================================================
# Windows specific files
# =============================================================================
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# =============================================================================
# Resource files
# =============================================================================
*.rc        text eol=crlf
*.rc2       text eol=crlf
*.manifest  text eol=crlf

# =============================================================================
# Documentation
# =============================================================================
*.md        text diff=markdown
*.txt       text
*.rtf       diff=astextplain
*.html      text diff=html
*.htm       text diff=html
*.css       text diff=css
*.js        text

# =============================================================================
# Serialization formats
# =============================================================================
*.json      text
*.xml       text
*.xsd       text
*.xsl       text
*.yml       text
*.yaml      text

# =============================================================================
# Configuration
# =============================================================================
*.ini       text
*.cfg       text
*.conf      text

# =============================================================================
# Graphics (binary)
# =============================================================================
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.bmp       binary
*.tif       binary
*.tiff      binary

# =============================================================================
# Archives (binary)
# =============================================================================
*.zip       binary
*.7z        binary
*.rar       binary
*.gz        binary
*.tar       binary

# =============================================================================
# Compiled files (binary)
# =============================================================================
*.exe       binary
*.dll       binary
*.lib       binary
*.pdb       binary
*.obj       binary
*.o         binary

# =============================================================================
# Fonts (binary)
# =============================================================================
*.ttf       binary
*.otf       binary
*.eot       binary
*.woff      binary
*.woff2     binary

# =============================================================================
# Audio/Video (binary)
# =============================================================================
*.mp3       binary
*.wav       binary
*.ogg       binary
*.mp4       binary
*.avi       binary
*.wmv       binary

# =============================================================================
# Export handling for archives
# =============================================================================
.gitattributes export-ignore
.gitignore     export-ignore
.github/       export-ignore
.editorconfig  export-ignore
.vs/           export-ignore

# =============================================================================
# Linguist overrides for GitHub statistics
# =============================================================================
# Mark certain files as documentation
ReadMe.txt linguist-documentation
*.md linguist-documentation

# Mark certain paths as vendored (third-party)
Services/Bzlib/* linguist-vendored
Services/zlib/* linguist-vendored
Services/SQLite/* linguist-vendored
Services/MiniUPnP/* linguist-vendored
Services/LibUTP/* linguist-vendored
