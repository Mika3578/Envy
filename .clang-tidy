# Clang-tidy starter for Envy (local / IDE).
# CI static analysis is CodeQL + MSVC Code Analysis — not this file.
# Legacy MFC produces too many false positives for a full check set; enable
# checks gradually during modernization. Do not treat a green local run as
# proof of protocol safety.

Checks: >
  -*,
  bugprone-use-after-move,
  bugprone-dangling-handle,
  bugprone-infinite-loop,
  misc-redundant-expression,
  readability-misleading-indentation

WarningsAsErrors: ''
HeaderFilterRegex: '^(Envy|TorrentEnvy|HashLib)/'
FormatStyle: file

CheckOptions:
  - key: readability-identifier-length.MinimumLength
    value: '2'
