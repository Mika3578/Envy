<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- x64: BugSplat 8 static /MT. Win32: vcpkg Crashpad (legacy Stage A). -->
  <PropertyGroup>
    <EnvyBugSplatRoot Condition="'$(EnvyBugSplatRoot)'==''">$(VcpkgManifestRoot)\ThirdParty\BugSplat</EnvyBugSplatRoot>
    <EnvyBugSplatLibMtDebug>$(EnvyBugSplatRoot)\x64\Debug\lib\mt</EnvyBugSplatLibMtDebug>
    <EnvyBugSplatLibMtRelease>$(EnvyBugSplatRoot)\x64\Release\lib\mt</EnvyBugSplatLibMtRelease>
    <EnvyBugSplatBinDebug>$(EnvyBugSplatRoot)\x64\Debug\bin</EnvyBugSplatBinDebug>
    <EnvyBugSplatBinRelease>$(EnvyBugSplatRoot)\x64\Release\bin</EnvyBugSplatBinRelease>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='x64'">
    <EnvyCrashExtraIncludeDirs>$(EnvyBugSplatRoot)\inc</EnvyCrashExtraIncludeDirs>
    <EnvyCrashLibDir Condition="'$(Configuration)'=='Debug'">$(EnvyBugSplatLibMtDebug)</EnvyCrashLibDir>
    <EnvyCrashLibDir Condition="'$(Configuration)'!='Debug'">$(EnvyBugSplatLibMtRelease)</EnvyCrashLibDir>
    <EnvyCrashLinkLibs>BugSplat.lib;wer.lib</EnvyCrashLinkLibs>
    <EnvyCrashPostBuildCmd>call "$(ProjectDir)CopyBugSplatRuntime.cmd" $(Configuration) $(Platform)</EnvyCrashPostBuildCmd>
    <EnvyCrashVcpkgIncludeCrashpad>false</EnvyCrashVcpkgIncludeCrashpad>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='Win32'">
    <EnvyCrashExtraIncludeDirs>$(EnvyVcpkgInstalled)\include\crashpad</EnvyCrashExtraIncludeDirs>
    <EnvyCrashLibDir>$(EnvyVcpkgLibDir)</EnvyCrashLibDir>
    <EnvyCrashLinkLibs>vcpkg_crashpad_client.lib;vcpkg_crashpad_client_common.lib;vcpkg_crashpad_util.lib;vcpkg_crashpad_base.lib</EnvyCrashLinkLibs>
    <EnvyCrashPostBuildCmd>call "$(ProjectDir)CopyCrashpadHandler.cmd" $(Configuration) $(Platform)</EnvyCrashPostBuildCmd>
    <EnvyCrashVcpkgIncludeCrashpad>true</EnvyCrashVcpkgIncludeCrashpad>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Platform)'=='x64'">
    <ClCompile>
      <PreprocessorDefinitions Condition="'$(EnvyBugSplatDatabase)'!=''">ENVY_BUGSPLAT_DATABASE=L&quot;$(EnvyBugSplatDatabase)&quot;;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <Target Name="ValidateEnvyBugSplatSdk" BeforeTargets="ClCompile" Condition="'$(Platform)'=='x64'">
    <Error Condition="!Exists('$(EnvyBugSplatRoot)\inc\BugSplat.h')" Text="Missing BugSplat SDK headers at $(EnvyBugSplatRoot)\inc. Run scripts\import-bugsplat-sdk.ps1 from the official native SDK (see ThirdParty\BugSplat\README.md)." />
    <Error Condition="!Exists('$(EnvyCrashLibDir)\BugSplat.lib')" Text="Missing $(EnvyCrashLibDir)\BugSplat.lib (official lib\mt). Run scripts\import-bugsplat-sdk.ps1 — public Samples binaries are /MD only." />
  </Target>
</Project>
