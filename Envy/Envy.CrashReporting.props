<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- BugSplat Native is the sole crash backend on Win32 and x64. -->
  <PropertyGroup>
    <EnvyBugSplatRoot Condition="'$(EnvyBugSplatRoot)'==''">$(EnvyRepoRoot)\ThirdParty\BugSplat</EnvyBugSplatRoot>
    <EnvyBugSplatArch Condition="'$(Platform)'=='Win32'">x86</EnvyBugSplatArch>
    <EnvyBugSplatArch Condition="'$(Platform)'=='x64'">x64</EnvyBugSplatArch>
    <EnvyBugSplatLibMt>$(EnvyBugSplatRoot)\$(EnvyBugSplatArch)\$(Configuration)\lib\mt</EnvyBugSplatLibMt>
    <EnvyBugSplatBin>$(EnvyBugSplatRoot)\$(EnvyBugSplatArch)\$(Configuration)\bin</EnvyBugSplatBin>
    <EnvyCrashRequiresVcpkg>false</EnvyCrashRequiresVcpkg>
    <EnvyCrashExtraIncludeDirs>$(EnvyBugSplatRoot)\inc</EnvyCrashExtraIncludeDirs>
    <EnvyCrashLibDir>$(EnvyBugSplatLibMt)</EnvyCrashLibDir>
    <EnvyCrashLinkLibs>BugSplat.lib;wer.lib</EnvyCrashLinkLibs>
    <EnvyCrashPostBuildCmd>set "VCToolsInstallDir=$(VCToolsInstallDir)" &amp;&amp; call "$(ProjectDir)CopyBugSplatRuntime.cmd" $(Configuration) $(Platform) "$(VCToolsInstallDir)"</EnvyCrashPostBuildCmd>
    <EnvyCrashVcpkgIncludeCrashpad>false</EnvyCrashVcpkgIncludeCrashpad>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions Condition="'$(EnvyBugSplatDatabase)'!=''">ENVY_BUGSPLAT_DATABASE=L&quot;$(EnvyBugSplatDatabase)&quot;;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalOptions>/ignore:4099 %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
  <Target Name="ValidateEnvyBugSplatSdk" BeforeTargets="ClCompile">
    <Error Condition="!Exists('$(EnvyBugSplatRoot)\inc\BugSplat.h')" Text="Missing BugSplat Native headers for $(Platform). Import the official Native SDK into ThirdParty\BugSplat." />
    <Error Condition="!Exists('$(EnvyCrashLibDir)\BugSplat.lib')" Text="Missing BugSplat Native $(Platform) $(Configuration) /MT library. Import the matching official SDK architecture." />
  </Target>
</Project>
