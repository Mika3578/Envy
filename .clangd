# clangd hints for Windows/MFC browsing. Incomplete without a compile_commands.json
# from MSBuild; prefer IntelliSense in Visual Studio for authoritative diagnostics.
CompileFlags:
  Add:
    - "-D_WINDOWS"
    - "-DWIN32"
    - "-D_WIN32"
    - "-DUNICODE"
    - "-D_UNICODE"
    - "-D_ENVY"
    - "-std=c++20"
