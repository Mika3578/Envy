# uhc:yang.cloud.bishopston.net:33558
# uhc:uhc.udp-host-cache.com:9999
# uhc:uhc2.limewire.com:20181

D https://peerates.net/servers.met
D http://www.gruk.org/server.met
D http://upd.emule-security.org/server.met
D http://www.emule-server.de/server.met/max/server.met
D https://www.emule-security.org/server.met
#D https://www.shortypower.org/server.met

H https://dchublist.org/hublist.xml.bz2
H https://hublist.pwiam.com/hublist.xml.bz2
H https://dchublist.ru/hublist.xml.bz2
